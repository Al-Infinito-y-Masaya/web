# Copy to `.env` and adjust. Only variables prefixed with VITE_ reach the browser.

# Base URL of the Mangroove API (no trailing slash).
# With the dev proxy below you can use a relative URL such as /api.
VITE_API_URL=http://localhost:8000

# Base URL of the static backup the engine publishes on the CDN (no trailing slash).
# When the API does not answer, the app reads the manifest, layers and summary from here.
# Leave empty to disable the backup.
VITE_RESPALDO_URL=

# Region opened by default when the API cannot list the regions.
VITE_REGION=estero_real

# XYZ template of the reference imagery drawn under the layers ({z}/{x}/{y}).
# Default: EOX Sentinel-2 cloudless 2016 (CC BY 4.0). Set it empty to hide the basemap.
# VITE_TESELAS_URL=

# Logs every API request/response in the console.
VITE_DEBUG=false

# Open the experimental musical explorer from the original website navigation.
VITE_EXPLORADOR_EXPERIMENTAL=false

# --- dev server only (not exposed to the browser) ---
# PORT=3000
# Proxies /api/* to this origin when set (see vite.config.ts).
# DEV_API_PROXY=http://localhost:8000

# URL used by `just download-schema` to fetch the OpenAPI schema.
# OPENAPI_URL=http://localhost:8000/openapi.json
